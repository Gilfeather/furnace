# Generated by packaging/homebrew/render.py in Gilfeather/furnace on each release; edits here are
# overwritten.
class Furnace < Formula
  desc "Inference server for Burn and ONNX models, speaking the KServe / Triton protocol"
  homepage "https://github.com/Gilfeather/furnace"
  license "MIT"

  on_macos do
    on_arm do
      url "https://github.com/Gilfeather/furnace/releases/download/v@VERSION@/furnace-macos-aarch64"
      sha256 "@SHA_furnace-macos-aarch64@"
    end
    on_intel do
      url "https://github.com/Gilfeather/furnace/releases/download/v@VERSION@/furnace-macos-x86_64"
      sha256 "@SHA_furnace-macos-x86_64@"
    end
  end

  on_linux do
    on_arm do
      url "https://github.com/Gilfeather/furnace/releases/download/v@VERSION@/furnace-linux-aarch64"
      sha256 "@SHA_furnace-linux-aarch64@"
    end
    on_intel do
      url "https://github.com/Gilfeather/furnace/releases/download/v@VERSION@/furnace-linux-x86_64"
      sha256 "@SHA_furnace-linux-x86_64@"
    end
  end

  # Weights of the built-in ResNet-18, found next to the binary
  resource "resnet18-weights" do
    url "https://github.com/Gilfeather/furnace/releases/download/v@VERSION@/resnet18.bpk"
    sha256 "@SHA_resnet18.bpk@"
  end

  def install
    # The binary and its weights stay together in libexec; bin gets a launcher
    libexec.install Dir["furnace-*"].first => "furnace"
    # A release asset is the bare binary, downloaded without the executable bit
    chmod 0755, libexec/"furnace"
    resource("resnet18-weights").stage { libexec.install "resnet18.bpk" }
    bin.write_exec_script libexec/"furnace"
  end

  test do
    assert_match version.to_s, shell_output("#{bin}/furnace --version")
  end
end
